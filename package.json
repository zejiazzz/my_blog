{
  "name": "my-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next start",
    "start": "next start",
    "lint": "eslint .",
    "check-type": "tsc --noEmit",
    "test:unit": "echo \"No unit tests configured yet\"",
    "test:smoke": "echo \"No smoke tests configured yet\"",
    "test:e2e": "echo \"No e2e tests configured yet\"",
    "verify:knowledge": "node scripts/verify-knowledge.mjs",
    "prepare": "husky",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "bash -c 'tsc --noEmit'"
